PORT=3000

# Azure Communication Services (phone)
CONNECTION_STRING=endpoint=https://YOUR_ACS.communication.azure.com/;accesskey=YOUR_KEY
FROM_PHONE_NUMBER=+1XXXXXXXXXX
CALLBACK_URI=https://your-app.onrender.com

# OpenAI public API (https://platform.openai.com/api-keys)
OPENAI_API_KEY=sk-your-key-here

# Batch AI (Whisper + chat + TTS) — optional fallback mode
OPENAI_CHAT_MODEL=gpt-4o-mini
OPENAI_TTS_VOICE=nova

# OpenAI Realtime streaming (default for phone + browser talk)
OPENAI_REALTIME_MODEL=gpt-4o-mini-realtime-preview
OPENAI_REALTIME_VOICE=alloy
